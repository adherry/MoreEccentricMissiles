<Defs>
    <!-- M71 PGM (Smoke) -->
    <ThingDef ParentName="EccentricDefenseGrid_BaseMakeableOrdnance"
        Class="EccentricDefenseGrid.OrdnanceDef">
        <defName>ETDG_Custom_Ordnance_M71PGM</defName>
        <label>M71 PGM (smoke)</label>
        <labelShort>M71 Smoke</labelShort>
        <description>A precision-guided short-range missile packed with a smoke generating compound that is already ignited at launch for maximum smoke coverage.\n\nIt is designed to be loaded into vertical missile launchers on military-grade starships and requires a guidance lock to fire.</description>
        <uiOrder>110</uiOrder>
        <graphicData>
            <texPath>Eccentric/Things/Items/Ordnance_M71_Smoke</texPath>
        </graphicData>
        <statBases>
            <MarketValue>330</MarketValue>
        </statBases>
        <costList>
            <Steel>50</Steel>
            <Chemfuel>35</Chemfuel>
            <ComponentIndustrial>2</ComponentIndustrial>
        </costList>
        <ordnance>
            <projectile>ETDG_Custom_Projectile_M71PGM</projectile>
            <effectRadius>9.9</effectRadius>
            <uiColor>(51,51,51)</uiColor>
        </ordnance>
        <comps>
            <li Class="CompProperties_Explosive">
                <explosiveRadius>9.9</explosiveRadius>
                <explosiveDamageType>Smoke</explosiveDamageType>
                <postExplosionGasType>BlindSmoke</postExplosionGasType>
            </li>
        </comps>
        <recipeMaker>
            <researchPrerequisites>
                <li>SmokepopBelt</li>
            </researchPrerequisites>
        </recipeMaker>
    </ThingDef>
    <!-- M71 PGM (Flare) -->
    <ThingDef ParentName="EccentricDefenseGrid_BaseMakeableOrdnance"
        Class="EccentricDefenseGrid.OrdnanceDef" MayRequire="aelanna.eccentrictech.flares2">
        <defName>ETDG_Custom_Ordnance_M72PGM_Flare</defName>
        <label>M72 PGM (flare)</label>
        <labelShort>M72 Flare</labelShort>
        <description>A precision-guided short-range missile loaded with a parachute flare. Illuminates a large area around the target.\n\nIt is designed to be loaded into vertical missile launchers on military-grade starships and requires a guidance lock to fire.</description>
        <uiOrder>120</uiOrder>
        <graphicData>
            <texPath>Eccentric/Things/Items/Ordnance_M72_Flare</texPath>
        </graphicData>
        <statBases>
            <MarketValue>330</MarketValue>
        </statBases>
        <costList>
            <Steel>50</Steel>
            <Chemfuel>40</Chemfuel>
            <ComponentIndustrial>2</ComponentIndustrial>
        </costList>
        <ordnance>
            <projectile>ETDG_Custom_Projectile_M72PGM_Flare</projectile>
            <effectRadius>2.9</effectRadius>
            <uiColor>(255,153,0)</uiColor>
        </ordnance>
        <comps>
            <li Class="CompProperties_Explosive">
                <explosiveRadius>2.9</explosiveRadius>
                <explosiveDamageType>Smoke</explosiveDamageType>
            </li>
        </comps>
    </ThingDef>
    <!-- M73 PGM (Heal) -->
    <ThingDef ParentName="EccentricDefenseGrid_BaseMakeableOrdnance"
        Class="EccentricDefenseGrid.OrdnanceDef">
        <defName>ETDG_Custom_Ordnance_M73PGM_Heal</defName>
        <label>M73 PGM (heal)</label>
        <labelShort>M73 Heal</labelShort>
        <description>A precision-guided short-range missile filled with a sticky mechanite gel made from glitterworld medicine. On impact it bursts into a cloud of heal-goop that immediately tends the wounds of every creature caught in it. Mechanoids are not affected.\n\nThe goop numbs pain for a few hours, but patients hate it. Being tended by a missile is not pleasant, and the goop is very sticky.\n\nIt is designed to be loaded into vertical missile launchers on military-grade starships and requires a guidance lock to fire.</description>
        <uiOrder>130</uiOrder>
        <graphicData>
            <texPath>Eccentric/Things/Items/Ordnance_Medical</texPath>
        </graphicData>
        <statBases>
            <MarketValue>500</MarketValue>
        </statBases>
        <costList>
            <Steel>50</Steel>
            <Silver>20</Silver>
            <Chemfuel>35</Chemfuel>
            <MedicineUltratech>4</MedicineUltratech>
        </costList>
        <ordnance>
            <projectile>ETDG_Custom_Projectile_M73PGM_Heal</projectile>
            <effectRadius>2.9</effectRadius>
            <uiColor>(140,205,255)</uiColor>
            <targetParams>
                <canTargetSelf>false</canTargetSelf>
                <canTargetPawns>true</canTargetPawns>
                <canTargetBuildings>false</canTargetBuildings>
                <canTargetLocations>true</canTargetLocations>
            </targetParams>
            <activeTracking>true</activeTracking>
        </ordnance>
        <comps>
            <li Class="CompProperties_Explosive">
                <explosiveRadius>2.9</explosiveRadius>
                <explosiveDamageType>ETDG_Custom_HealGoop</explosiveDamageType>
                <requiredDamageTypeToExplode>Flame</requiredDamageTypeToExplode>
            </li>
        </comps>
        <storedConceptLearnOpportunity>EccentricDefenseGrid_TrackingMissiles</storedConceptLearnOpportunity>
    </ThingDef>
</Defs>