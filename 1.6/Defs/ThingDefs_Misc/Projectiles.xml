<Defs>
    <!-- M71 PGM (Smoke) -->
    <ThingDef ParentName="EccentricDefenseGrid_BaseArtilleryProjectile">
        <defName>ETDG_Custom_Projectile_M71PGM</defName>
        <label>M71 precision guided missile</label>
        <graphicData>
            <texPath>Eccentric/Things/Projectiles/Projectile_M71_Smoke</texPath>
        </graphicData>
        <projectile>
            <damageDef>Smoke</damageDef>
            <speed>40</speed>
            <explosionRadius>10</explosionRadius>
            <flyOverhead>true</flyOverhead>
            <!-- <soundExplode>Explosion_EMP</soundExplode> -->
            <postExplosionGasType>BlindSmoke</postExplosionGasType>
        </projectile>
        <modExtensions>
            <li Class="EccentricProjectiles.ModExtension_ProjectileEffects">
                <effects>
                    <li>Eccentric_ArtilleryMissileTrail</li>
                    <li>Eccentric_ArtilleryMissileSmoke</li>
                    <li>Eccentric_ArtilleryMissileExhaust</li>
                </effects>
                <stages>
                    <li>
                        <label>ejected</label>
                        <type>Launch</type>
                        <duration>24</duration>
                        <overrideInitialAngle>true</overrideInitialAngle>
                        <angle>-90</angle>
                        <initialHeight>0.1</initialHeight>
                        <heightOffset>2</heightOffset>
                        <heightFunction>EaseOutQuad</heightFunction>
                        <startSound>Eccentric_ArtilleryMissileEject</startSound>
                    </li>
                    <li>
                        <label>tracking</label>
                        <type>Terminal</type>
                        <speed>40</speed>
                        <positionFunction>EaseInCubic</positionFunction>
                        <arcFactor>12</arcFactor>
                        <startSound>Eccentric_ArtilleryMissileIgnite</startSound>
                    </li>
                </stages>
            </li>
        </modExtensions>
    </ThingDef>
    <!-- M72 PGM (Flare) -->
    <ThingDef ParentName="EccentricDefenseGrid_BaseArtilleryProjectile" MayRequire="aelanna.eccentrictech.flares2">
        <defName>ETDG_Custom_Projectile_M72PGM_Flare</defName>
        <label>M72 precision guided flare</label>
        <graphicData>
            <texPath>Eccentric/Things/Projectiles/Projectile_M72_Flare</texPath>
        </graphicData>
        <projectile>
            <damageDef>Smoke</damageDef>
            <speed>40</speed>
            <flyOverhead>true</flyOverhead>
            <preExplosionSpawnThingDef>EccentricSkyFlareMortar</preExplosionSpawnThingDef>
            <soundExplode>Eccentric_FlareIgnite</soundExplode>
        </projectile>
        <modExtensions>
            <li Class="EccentricProjectiles.ModExtension_ProjectileEffects">
                <effects>
                    <li>Eccentric_ArtilleryMissileTrail</li>
                    <li>Eccentric_ArtilleryMissileSmoke</li>
                    <li>Eccentric_ArtilleryMissileExhaust</li>
                </effects>
                <stages>
                    <li>
                        <label>ejected</label>
                        <type>Launch</type>
                        <duration>24</duration>
                        <overrideInitialAngle>true</overrideInitialAngle>
                        <angle>-90</angle>
                        <initialHeight>0.1</initialHeight>
                        <heightOffset>2</heightOffset>
                        <heightFunction>EaseOutQuad</heightFunction>
                        <startSound>Eccentric_ArtilleryMissileEject</startSound>
                    </li>
                    <li>
                        <label>tracking</label>
                        <type>Terminal</type>
                        <speed>40</speed>
                        <positionFunction>EaseInCubic</positionFunction>
                        <arcFactor>8</arcFactor>
                        <arcFunction>EaseOutCubic</arcFunction>
                        <startSound>Eccentric_ArtilleryMissileIgnite</startSound>
                    </li>
                </stages>
            </li>
        </modExtensions>
    </ThingDef>
    <!-- M73 PGM (Heal), flight characteristics copied from the M48 PGM (HEAT) -->
    <ThingDef ParentName="EccentricDefenseGrid_BaseArtilleryProjectile">
        <defName>ETDG_Custom_Projectile_M73PGM_Heal</defName>
        <label>M73 precision guided heal-goop missile</label>
        <thingClass>MoreEccentricMissiles.Projectile_HealGoopMissile</thingClass>
        <graphicData>
            <texPath>Eccentric/Things/Projectiles/Projectile_Medical</texPath>
        </graphicData>
        <projectile>
            <damageDef>ETDG_Custom_HealGoop</damageDef>
            <damageAmountBase>1</damageAmountBase>
            <explosionRadius>1.9</explosionRadius>
            <speed>40</speed>
            <shadowSize>0.6</shadowSize>
            <arcHeightFactor>14</arcHeightFactor>
            <flyOverhead>true</flyOverhead>
            <soundExplode>Explosion_EMP</soundExplode>
            <explosionEffect>ETDG_Custom_HealGoopExplosion</explosionEffect>
            <postExplosionSpawnThingDef>ETDG_Custom_Filth_HealGoop</postExplosionSpawnThingDef>
            <postExplosionSpawnThingCount>3</postExplosionSpawnThingCount>
        </projectile>
        <modExtensions>
            <li Class="MoreEccentricMissiles.ProjectileExtension_ImpactDamage">
                <damageDef>Blunt</damageDef>
                <amount>5</amount>
            </li>
            <li Class="EccentricProjectiles.ModExtension_ProjectileEffects">
                <activeTracking>true</activeTracking>
                <effects>
                    <li>Eccentric_ArtilleryMissileTrail</li>
                    <li>Eccentric_ArtilleryMissileSmoke</li>
                    <li>Eccentric_ArtilleryMissileExhaust</li>
                </effects>
                <impactEffects>
                    <li>Eccentric_ArtilleryImpactDistortion</li>
                </impactEffects>
                <stages>
                    <li>
                        <label>ejected</label>
                        <type>Launch</type>
                        <duration>24</duration>
                        <overrideInitialAngle>true</overrideInitialAngle>
                        <angle>-90</angle>
                        <initialHeight>0.1</initialHeight>
                        <heightOffset>2</heightOffset>
                        <heightFunction>EaseOutQuad</heightFunction>
                        <startSound>Eccentric_ArtilleryMissileEject</startSound>
                    </li>
                    <li>
                        <label>tracking</label>
                        <type>Terminal</type>
                        <speed>40</speed>
                        <positionFunction>EaseInQuad</positionFunction>
                        <arcFactor>12</arcFactor>
                        <arcFunction>EccentricDefenseGrid_TopDown</arcFunction>
                        <startSound>Eccentric_ArtilleryMissileIgnite</startSound>
                    </li>
                </stages>
            </li>
        </modExtensions>
    </ThingDef>
</Defs>