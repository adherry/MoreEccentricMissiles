<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>MoreEccentricMissiles</RootNamespace>
    <AssemblyName>MoreEccentricMissiles</AssemblyName>
    <OutputPath>../1.6/Assemblies/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>

    <!-- Override on the command line if your install differs: dotnet build -p:RimWorldManaged=... -p:WorkshopDir=... -->
    <RimWorldManaged Condition="'$(RimWorldManaged)' == ''">/mnt/games/SteamLibrary/steamapps/common/RimWorld/RimWorldLinux_Data/Managed</RimWorldManaged>
    <WorkshopDir Condition="'$(WorkshopDir)' == ''">/mnt/games/SteamLibrary/steamapps/workshop/content/294100</WorkshopDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManaged)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RimWorldManaged)/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManaged)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Eccentric Tech - Defense Grid (hard dependency) -->
    <Reference Include="0EccentricProjectiles">
      <HintPath>$(WorkshopDir)/3066838686/1.6/Assemblies/0EccentricProjectiles.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
